# 로컬 개발용 샘플 값입니다. cp apps/api/.env.example apps/api/.env 후 사용합니다.
# 실제 비밀값은 여기나 저장소에 넣지 않습니다(배포 값은 SSM Parameter Store, docs/deploy.md).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# pnpm db:up으로 띄운 로컬 Postgres (infra/compose.yaml)
DATABASE_URL=postgresql://wolgyeham:local-development-only@127.0.0.1:54329/wolgyeham
# 웹 주소. 로그인 후 이동·초대 링크·쿠키 Secure 판단에 씁니다. 브라우저 주소와 호스트를 맞춥니다.
APP_ORIGIN=http://localhost:5173
# 카카오 로그인 중 state·returnTo 쿠키 서명용(32자 이상). 카카오 키가 있으면 필수. 예: openssl rand -hex 32
SESSION_SECRET=local-development-only-change-me-0123456789
# 카카오 로그인. 비어 있으면 /api/auth/kakao/*가 503 KAKAO_NOT_CONFIGURED입니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 비우면 ${APP_ORIGIN}/api/auth/kakao/callback
KAKAO_REDIRECT_URI=
# true면 시연 API(/api/dev/login·demo·reset·end-demo 등, docs/backend.md)가 열립니다. 로컬·dev 시연 전용.
# 시연 계정·시연 건물은 둘러보기 전용입니다(D-35).
DEMO_MODE=true
# true면 시연 모드에서 e2e 전용 계정(테스트빌라 집주인)으로도 시연 로그인하고 /api/dev/demo에 e2e 건물이 나옵니다.
# 이 계정은 테스트빌라를 바꿀 수 있으므로 로컬·e2e(pnpm e2e)에서만 켭니다. 배포(dev·prod)는 비우거나 false.
E2E_LOGIN=true
# API 문서(/api/swagger 등). 비우면 NODE_ENV=production일 때만 꺼집니다.
API_DOCS=
# 요청 앞의 신뢰하는 프록시 수(가입코드 반복 제한의 클라이언트 IP). 로컬은 0(소켓 주소).
TRUSTED_PROXY_HOPS=0
# 앞단(CloudFront)이 붙이는 X-Origin-Verify 헤더 값(32자 이상). 있으면 이 헤더가 맞을 때만 X-Forwarded-For를 믿고
# 체인 모양(바로: 마지막 값, Amplify 경유: 끝에서 세 번째)으로 클라이언트 IP를 고릅니다. 로컬은 비워 둡니다. 배포 값은 SSM에만.
ORIGIN_VERIFY_SECRET=
# 연결·‘아직 살아요’ 뒤 재확인을 요청하기까지의 일수(기본 365, ‘1년에 한 번’). 요청 뒤 14일 무응답이면 reconfirm_needed.
RECONFIRM_INTERVAL_DAYS=365
# 웹 푸시(VAPID). 셋 다 있어야 켜지고, 비우면 공지 알림을 보내지 않습니다. 키 형식이 틀리면 API가 시작하지 않습니다.
# 키 만들기: pnpm --filter @wolgyeham/api exec web-push generate-vapid-keys. VAPID_SUBJECT는 mailto: 또는 https:// 주소.
# 개인키는 apps/api/.env(로컬)나 SSM(배포)에만 둡니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# 안내·공지 사진 저장소. local(폴더, 로컬 기본) · s3(PHOTO_BUCKET, 배포) · off(받지 않음, production 기본).
# s3 자격 증명은 EC2 인스턴스 역할(기본 체인)에서 받고 여기에 키를 넣지 않습니다(docs/deploy.md).
PHOTO_STORE=local
PHOTO_BUCKET=
# 버킷 안의 환경 접두사(예: dev/, prod/). 비우면 맨 위
PHOTO_PREFIX=
# PHOTO_STORE=local의 폴더(API를 실행한 폴더 기준, gitignore된 .data/)
PHOTO_LOCAL_DIR=.data/photos
AWS_REGION=ap-northeast-2
