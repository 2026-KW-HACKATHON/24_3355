{
  "name": "@wolgyeham/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "@scalar/hono-api-reference": "0.12.5",
    "@wolgyeham/contracts": "workspace:*",
    "hono": "4.13.9",
    "hono-openapi": "1.3.3",
    "zod": "4.6.5"
  }
}
