# VITE_ values are public. Never put secrets or OAuth client secrets here.
API_PROXY_TARGET=http://127.0.0.1:3001
# 개발 도구(react-grab·react-scan)는 기본으로 꺼져 있습니다. 켜면 하단 버튼을 가릴 수 있습니다.
# VITE_ENABLE_REACT_DEVTOOLS=1
# 현관 QR·입주 카드에 인쇄할 공개 주소의 출처. 비우면 지금 연 주소를 씁니다(PR 미리 보기·로컬 주소가 인쇄될 수 있음).
# VITE_PUBLIC_ORIGIN=https://example.com
# 월계함 팀 연락처(오픈채팅·문의 폼 https 주소나 mailto:). 건물 확인(23)의 ‘팀에 알리기’와 약관·개인정보 처리방침의 문의에 씁니다.
# 비우면 ‘팀에 알리기’를 숨기고, 약관에는 문의 창구를 준비 중이라고 적습니다.
# VITE_TEAM_CONTACT_URL=https://open.kakao.com/o/example
