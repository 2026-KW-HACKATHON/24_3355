# CloudFront → EC2 원본 구간 HTTPS (decisions.md D-31). compose의 caddy 서비스가 이 폴더를 /etc/caddy로 씁니다.
# 폴더째로 연결하는 이유: 파일 하나만 연결하면 배포 때 s3 sync가 새 파일로 바꿔도 컨테이너는 이전 파일을 봅니다.
# 값은 env/caddy.env에서 옵니다(deploy.sh가 server.env와 SSM 값으로 만듦, 저장소·로그에 남기지 않음).
#   ORIGIN_DOMAIN                원본 이름의 뒷부분. 기본은 탄력적 IP로 만든 <a-b-c-d>.sslip.io
#   ACME_EMAIL                   ZeroSSL로 인증서를 받을 때 필요한 연락 주소
#   DEV_/PROD_ORIGIN_VERIFY_SECRET  CloudFront가 붙이는 X-Origin-Verify 값 (SSM /wolgyeham/<env>/ORIGIN_VERIFY_SECRET)
# 443: dev.<ORIGIN_DOMAIN> → api-dev, prod.<ORIGIN_DOMAIN> → api-prod. X-Origin-Verify가 그 환경 값과 다르면 403.
# 80: 인증서 발급 확인(HTTP-01)과 HTTPS로 넘기기만 합니다(Caddy 기본 동작). API로 넘기지 않습니다.
# 접근 로그는 켜지 않습니다(클라이언트 주소를 남기지 않음, backend.md §8).
{
	# Let's Encrypt가 실패하면 ZeroSSL로 받습니다. sslip.io는 공개 접미사 목록에 없어 모든 사용자가
	# Let's Encrypt의 같은 도메인 한도를 나눠 쓰므로 한도에 걸릴 수 있습니다.
	# 보안 그룹이 443을 CloudFront에만 열어 TLS-ALPN 확인은 실패하므로 HTTP-01만 씁니다.
	cert_issuer acme {
		disable_tlsalpn_challenge
	}
	cert_issuer acme https://acme.zerossl.com/v2/DV90 {
		email {$ACME_EMAIL}
		disable_tlsalpn_challenge
	}
}

# 인자: X-Origin-Verify 값, 넘길 컨테이너. 비밀값이 비면 인자 수가 맞지 않아 설정이 거부됩니다(열린 채로 뜨지 않음).
(origin) {
	@not_cloudfront not header X-Origin-Verify {args[0]}
	respond @not_cloudfront 403
	reverse_proxy {args[1]} {
		# CloudFront가 보낸 X-Forwarded-For를 그대로 넘깁니다. 기본 동작은 이 값을 버리고 접속한 CloudFront 주소로
		# 바꾸므로 API가 클라이언트를 찾지 못합니다. 그대로 넘기면 API가 보는 체인 모양이 바뀌지 않습니다(D-23).
		header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
	}
}

dev.{$ORIGIN_DOMAIN} {
	import origin {$DEV_ORIGIN_VERIFY_SECRET} api-dev:3001
}

prod.{$ORIGIN_DOMAIN} {
	import origin {$PROD_ORIGIN_VERIFY_SECRET} api-prod:3001
}
