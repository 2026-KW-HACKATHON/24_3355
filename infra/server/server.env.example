# /opt/wolgyeham/server.env 예시. 비밀값이 아닌 서버 설정만 둡니다(비밀값은 SSM Parameter Store).
AWS_REGION=ap-northeast-2
API_IMAGE=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/wolgyeham-api
OPS_BUCKET=wolgyeham-ops-<계정ID>
# CloudFront → 원본 HTTPS(D-31). caddy가 dev.<ORIGIN_DOMAIN>, prod.<ORIGIN_DOMAIN> 인증서를 받습니다.
# 기본은 탄력적 IP의 점을 -로 바꾼 sslip.io 이름(예: 13-124-0-10.sslip.io). 팀 도메인으로 바꾸는 법은 docs/aws-setup.md 7-A.
ORIGIN_DOMAIN=<a-b-c-d>.sslip.io
# ZeroSSL로 인증서를 받을 때 필요한 연락 주소(Let's Encrypt가 실패할 때만 씀)
ACME_EMAIL=<연락 이메일>
# 원본을 HTTPS로 옮기는 동안에만 두는 값. 없으면 API 포트를 서버 안(127.0.0.1)에서만 엽니다.
# API_BIND_ADDRESS=0.0.0.0
